-  # Receive as much as we can in a few second time period
-  rx = []
-  old_len = 0
-  start_time = time.monotonic()
-  while time.monotonic() - start_time < 5 or len(rx) > old_len:
-    old_len = len(rx)
-    rx.extend(panda_jungle.can_recv())
