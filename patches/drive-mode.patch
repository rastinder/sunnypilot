+    a, b = self._buf(16, dtypes.uint8), self._buf(16, dtypes.uint8)
+    self.assertEqual(self._run(both, self._buf(2), a, b), [a.buffer.get_buf("CPU"), b.buffer.get_buf("CPU")])
