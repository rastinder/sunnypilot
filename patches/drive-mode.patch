-          can_set_checksum(&to_send);
-
-          can_send(&to_send, to_send.bus, true);
-        }
-      }
-
-      delay(1000);
-      continue;
-    }
-
-    // useful for debugging, fade breaks = panda is overloaded
-    for (uint32_t fade = 0U; fade < MAX_LED_FADE; fade += 1U) {
