+    [BydCarDocs("BYD Atto 3 2022-25")],
+    CarSpecs(wheelbase=2.72, steerRatio=14.8),
+  )
+
+
+FW_QUERY_CONFIG = FwQueryConfig(
+  requests=[],
+  fw_version_regex=b"",
+)
+
+
+DBC = CAR.create_dbc_map()
