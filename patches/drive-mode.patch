+    [&]<std::size_t... Ns>(std::index_sequence<Ns...>) {
+        ([&]<std::size_t N>() {
+            [&]<std::size_t... Ms>(std::index_sequence<Ms...>) {
+                ([&]<std::size_t M>() {
