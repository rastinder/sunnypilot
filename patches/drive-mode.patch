+void MainWindow::selectAndOpenStream() {
+  stream_selector_.open([this](std::unique_ptr<AbstractStream> stream, const std::string &dbc_file) {
+    if (stream) {
+      openStream(std::move(stream), dbc_file);
+    } else if (!stream_) {
+      openStream(std::make_unique<DummyStream>());
+    }
+  });
+}
