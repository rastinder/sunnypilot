+                            if constexpr (std::is_same_v<U2, bf16_2> || std::is_same_v<U2, half_2>) {
+                                // Use two ds_read_b64_tr_b16 for stride == 8, dtype == bf16
+                                if constexpr (RT::base_tile_stride == 8) {
+                                    asm volatile(
+                                        "ds_read_b64_tr_b16 %0, %2 offset:%4\n"
