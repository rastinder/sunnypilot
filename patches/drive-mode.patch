+                        'attention.head_count':4, 'attention.head_count_kv':2, 'attention.key_length':4, 'rope.dimension_count':2}.items():
+        writer.add_uint32('qwen35.'+key, value)
+      writer.add_float32('qwen35.rope.freq_base', 10000)
