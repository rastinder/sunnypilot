+  const uint8_t short_data[] = {0};
+  range.add(short_data, 1);
+  range.add(first, 3);
+  REQUIRE(range.bytes == std::vector<uint32_t>({2, 0, 0}));
+  REQUIRE(HeatmapCounts(0).bits.empty());
