+void MainWindow::openFile(SourceSet s) {
+  remindSaveChanges([this, s]() {
+    FileDialog::getOpenFileName("Open File", settings.last_dir, ".dbc", [this, s](const std::string &fn) {
+      if (!fn.empty()) {
+        loadFile(fn, s);
