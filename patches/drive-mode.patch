+    super().map(SimpleNamespace(device=buf.owner.device, _buf=buf.va_addr, nbytes=buf.size, meta=buf.meta))
+    return HCQBuffer(buf.va_addr, buf.size, meta=buf.meta, owner=buf.owner)
