+
+_EDGE_SLOTS = 16
+_MINIMAL_EXAMPLES = 10
+_INTEGER_RANGES = {
+  "int8": (-2**7, 2**7 - 1),
+  "int16": (-2**15, 2**15 - 1),
+  "int32": (-2**31, 2**31 - 1),
+  "int64": (-2**63, 2**63 - 1),
+  "uint8": (0, 2**8 - 1),
+  "uint16": (0, 2**16 - 1),
