+# ruff: noqa: E501,F403,F405
+from tinygrad.runtime.autogen.amd.cdna.ins import *
+
+class Kernel:
+  def __init__(self): self.instructions, self.labels, self.pos = [], {}, 0
+  def label(self, name): self.labels[name] = self.pos
+  def emit(self, inst, target=None):
+    self.instructions.append(inst)
+    inst._target, inst._pos = target, self.pos
+    self.pos += inst.size()
+  def waitcnt(self, lgkm=None, vm=None, exp=None):
+    vmcnt, lgkmcnt, expcnt = vm if vm is not None else 63, lgkm if lgkm is not None else 15, exp if exp is not None else 7
+    waitcnt = (vmcnt & 0xf) | ((expcnt & 0x7) << 4) | ((lgkmcnt & 0xf) << 8) | ((vmcnt & 0x30) << 10)
+    self.emit(s_waitcnt(simm16=waitcnt))
+  def finalize(self):
+    for inst in self.instructions:
+      if inst._target is not None: inst.simm16 = (self.labels[inst._target] - inst._pos - inst.size()) // 4
+    return self.instructions
+
+def v_mfma_fp4(dst, a, b, opsel, opsel_hi, scale_a, scale_b):
