+template <typename T>
+__device__ __forceinline__ void ds_read_b32(T& dst, const uint32_t smem_ptr, const int i_offset) {
+  static_assert(sizeof(T) == sizeof(uint32_t));
+  asm volatile("ds_read_b32 %0, %1 offset:%2"
+    : "=v"(dst)
+    : "v"(smem_ptr), "i"(i_offset)
+    : "memory");
+}
