+    with Context(NOOPT=1):
+      t = Tensor.ones(256, 256).contiguous().realize()
+      linear = compile_linear(t.triu().schedule_linear())
+      self.assertLessEqual(estimate_uop(linear.src[-1]).ops, 4 * 256 * 256)
+
+if __name__ == '__main__':
+  unittest.main()
