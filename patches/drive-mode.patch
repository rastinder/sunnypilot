+template<typename op, ducks::rt::all T>
+__device__ static inline void bin_map(T &dst, const T &lhs, const T &rhs) {
+    #pragma unroll
+    for(int i = 0; i < dst.height; i++) {
+        #pragma unroll
+        for(int j = 0; j < dst.width; j++) {
+            #pragma unroll
+            for(int k = 0; k < dst.packed_per_base_tile; k++) {
