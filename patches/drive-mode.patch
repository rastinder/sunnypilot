+                        a.tiles[N][0],
+                        b.tiles[M][0],
+                        c.tiles[N][M],
+                        scale_a,
+                        scale_b
+                    );
+                }.template operator()<Ms>(), ...);
+            }(std::make_index_sequence<D::width>{});
+        }.template operator()<Ns>(), ...);
+    }(std::make_index_sequence<D::height>{});
+}
