+def call_gradient(ctx:UOp, k:UOp, needed:set[int]) -> tuple[UOp|None, ...]:
+  fxn, args = k.body, k.src[1:]
+  outputs = {st.src[0].unsharded_base.arg.slot:st for st in fxn.src
